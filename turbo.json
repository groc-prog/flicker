{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "POSTGRES_DATABASE_URL",
    "SERVICE_NAME",
    "SERVICE_VERSION",
    "LOG_LEVEL",
    "OTEL_COLLECTOR_URL",
    "OTEL_COLLECTOR_METRICS_EXPORT_INTERVAL",
    "BUNQUEUE_DATA_PATH",
    "TMDB_API_TOKEN",
    "JOB_CINEMA_DATA_SCRAPING_SCHEDULE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^type-check"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "drizzle-kit:studio": {
      "cache": false,
      "persistent": true
    },
    "drizzle-kit:generate": {
      "cache": false
    },
    "drizzle-kit:migrate": {
      "cache": false
    }
  }
}
