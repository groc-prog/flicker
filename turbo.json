{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "env": [
        "POSTGRES_DATABASE_URL",
        "SERVICE_NAME",
        "SERVICE_VERSION",
        "LOG_LEVEL",
        "OTEL_COLLECTOR_URL",
        "OTEL_COLLECTOR_METRICS_EXPORT_INTERVAL",
        "BUNQUEUE_DATA_PATH",
        "TMDB_API_TOKEN",
        "JOB_SCRAPE_CINEMA_DATA_CRON",
        "DISCORD_BOT_TOKEN",
        "DISCORD_APP_ID",
        "DISCORD_DEVELOPMENT_GUILD_ID"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "turbo.json"
      ],
    },
    "type-check": {
      "dependsOn": [
        "^type-check"
      ]
    },
    "test": {
      "env": [
        "POSTGRES_DATABASE_URL",
        "BUNQUEUE_DATA_PATH",
        "LOG_LEVEL",
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.test.local"
      ],
      "dependsOn": [
        "^test"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "drizzle-kit:studio": {
      "cache": false,
      "persistent": true
    },
    "drizzle-kit:generate": {
      "cache": false
    },
    "drizzle-kit:migrate": {
      "cache": false
    }
  }
}
