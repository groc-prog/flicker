# The .dockerignore file excludes files from the container server process.
#
# Mainly derived from RisingStack/kubernetes-nodejs-example
# https://github.com/RisingStack/kubernetes-nodejs-example/blob/master/.dockerignore
#
# https://docs.docker.com/engine/reference/builder/#dockerignore-file

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release
**/build

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules
**/node_modules

**/*.spec.ts

# Docker
.postgres
.openobserve

# Bunqueue
.bunqueue

# Turbo
.turbo

# Local env files
.env
.env.act
.env.local
.env.development.local
.env.test.local
.env.production.local
