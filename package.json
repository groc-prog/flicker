{
  "name": "flicker",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" \"!./.(postgres|openobserve)/**\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "drizzle-kit:studio": "bun run --env-file=.env turbo run drizzle-kit:studio",
    "drizzle-kit:generate": "bun run --env-file=.env turbo run drizzle-kit:generate --",
    "drizzle-kit:migrate": "bun run --env-file=.env turbo run drizzle-kit:migrate",
    "pre-commit": "turbo run lint type-check --affected",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
