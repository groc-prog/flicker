  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "internalConsoleOptions": "neverOpen",
      "request": "launch",
      "name": "Debug: @flicker/workers",
      "program": "${workspaceFolder}/apps/workers/src/index.ts",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false,
      "args": [
        "--preload",
        "${workspaceFolder}/apps/workers/src/telemetry/instrumentation.ts"
      ]
    }
  ]
}
